rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isImageFile() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }
    
    function isPdfFile() {
      return request.resource.contentType == 'application/pdf'
        && request.resource.size < 15 * 1024 * 1024; // 15MB max
    }

    // 1. User avatars
    match /users/{userId}/avatar/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.role == 'admin') && isImageFile();
    }

    // 2. Event banners
    match /events/{eventId}/banner/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
    }

    // 3. Event payment QR codes
    match /events/{eventId}/qr/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
    }

    // 4. Event gallery
    match /events/{eventId}/gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
      allow delete: if isAuthenticated();
    }

    // 5. Payment proof screenshots
    match /events/{eventId}/payment/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImageFile();
    }

    // 6. Certificates
    match /certificates/{certificateId}/{allPaths=**} {
      allow read: if true; // Publicly verifiable
      allow write: if isAuthenticated() && (isPdfFile() || isImageFile());
    }
  }
}
