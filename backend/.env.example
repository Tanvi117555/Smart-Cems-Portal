# ==============================================================================
# SMART CEMS BACKEND ENVIRONMENT CONFIGURATION (Render / Production)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# CORS Whitelist (e.g. Vercel deployment URL)
FRONTEND_URL=https://your-cems-frontend.vercel.app,http://localhost:5173

# Firebase Admin Credentials
# Option 1: Base64-encoded Service Account JSON (Recommended for Render)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option 2: Individual credential fields
FIREBASE_PROJECT_ID=smart-cems-portal
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@smart-cems-portal.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# SMTP Email Notification Credentials (Optional - Graceful fallback to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=events@cems.edu
SMTP_PASS=your_app_password
EMAIL_FROM="Smart CEMS <noreply@cems.edu>"
